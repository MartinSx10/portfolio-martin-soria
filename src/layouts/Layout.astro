---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Martín Soria — Desarrollador Full Stack",
  description = "Martín Soria, desarrollador full stack en La Rioja, Argentina. Sistemas de gestión, e-commerce y plataformas web para negocios y municipios.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <script is:inline>
      // Se corre antes de pintar para que no haya flash de tema incorrecto
      (function () {
        const saved = localStorage.getItem("theme");
        const theme =
          saved ?? (window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
