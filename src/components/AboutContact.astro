<style>
  section {
    padding: 72px 0;
  }
  .duo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--bg-soft);
    border: 1px solid var(--line-soft);
    border-radius: 22px;
    overflow: hidden;
  }
  .duo-col {
    padding: 42px 44px;
  }
  .duo-col + .duo-col {
    border-left: 1px solid var(--line-soft);
  }
  .duo h2 {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 22px;
    margin-bottom: 20px;
  }
  .duo h2 .chip {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--violet) 14%, transparent);
    color: var(--violet-soft);
    font-size: 16px;
  }
  .duo p {
    color: var(--muted);
    font-size: 15px;
    margin-bottom: 16px;
  }
  .facts {
    display: grid;
    gap: 14px;
    margin-top: 26px;
  }
  .fact {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14.5px;
  }
  .fact .chip {
    width: 32px;
    height: 32px;
    flex: none;
    border-radius: 9px;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--violet) 13%, transparent);
    color: var(--violet-soft);
    font-size: 15px;
  }
  .contact-list {
    display: grid;
    gap: 16px;
    margin: 26px 0 30px;
  }
  .contact-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14.5px;
    color: var(--text);
  }
  a.contact-item:hover {
    color: var(--violet-soft);
  }
  .socials {
    display: flex;
    gap: 12px;
  }
  .socials a {
    width: 42px;
    height: 42px;
    border-radius: 11px;
    display: grid;
    place-items: center;
    background: var(--card);
    border: 1px solid var(--line-soft);
    color: var(--muted);
    transition: color 0.15s, border-color 0.15s;
  }
  .socials a:hover {
    color: var(--text);
    border-color: var(--line);
  }

  @media (max-width: 960px) {
    .duo {
      grid-template-columns: 1fr;
    }
    .duo-col + .duo-col {
      border-left: none;
      border-top: 1px solid var(--line-soft);
    }
  }
  @media (max-width: 680px) {
    .duo-col {
      padding: 32px 26px;
    }
    section {
      padding: 56px 0;
    }
  }
</style>
