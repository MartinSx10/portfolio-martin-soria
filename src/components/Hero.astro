---
import fs from "node:fs";
import path from "node:path";

const photoPath = "/foto-martin.jpg";
const photoExists = fs.existsSync(path.join(process.cwd(), "public", photoPath));
---

<section class="hero" id="inicio">
  <div class="wrap hero-grid">
    <div>
      <span class="hero-badge">¡Hola! Soy Martín 👋</span>
      <h1>Desarrollador Full Stack enfocado en crear <span class="accent">soluciones digitales</span></h1>
      <p>Transformo ideas en aplicaciones web modernas y escalables.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#proyectos">
          Ver mis proyectos
          <svg class="i" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </a>
        <a class="btn btn-ghost" href="#contacto">
          Contactarme
          <svg class="i" viewBox="0 0 24 24"><path d="M4 6h16v12H4zM4 7l8 6 8-6"/></svg>
        </a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="portrait">
        {
          photoExists ? (
            <img class="portrait-photo" src={photoPath} alt="Foto de Martín Soria" />
          ) : (
            <>
              <div class="dots"></div>
              <div class="portrait-hint">
                <span class="big">MS</span>
                Acá va tu foto — reemplazá /public/foto-martin.jpg y usá esa imagen en este bloque
              </div>
            </>
          )
        }
      </div>
      <div class="exp-card">
        <span class="exp-icon">🚀</span>
        <span>
          <span class="exp-title">+3 años</span><br />
          <span class="exp-sub">Construyendo soluciones web</span>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 88px 0 72px;
    overflow: hidden;
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(560px 380px at 78% 30%, var(--violet-glow), transparent 65%),
      radial-gradient(420px 320px at 8% 80%, rgba(91, 140, 255, 0.1), transparent 60%);
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--violet-soft);
    background: color-mix(in srgb, var(--violet) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--violet) 25%, transparent);
    padding: 7px 16px;
    border-radius: 999px;
    margin-bottom: 24px;
  }
  .hero h1 {
    font-size: clamp(34px, 5vw, 54px);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .hero h1 .accent {
    background: linear-gradient(90deg, var(--violet-soft), #6ea8ff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero p {
    color: var(--muted);
    max-width: 44ch;
    margin: 20px 0 32px;
    font-size: 17px;
  }
  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 14px;
    padding: 11px 20px;
    border-radius: 12px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s;
  }
  .btn-primary {
    background: linear-gradient(135deg, #6d4df6, #8b6bff);
    color: #fff;
    box-shadow: 0 6px 24px -6px var(--violet-glow);
  }
  .btn-primary:hover {
    transform: translateY(-1px);
  }
  .btn-ghost {
    border-color: var(--line);
    color: var(--text);
  }
  .btn-ghost:hover {
    border-color: var(--violet-soft);
  }

  .hero-visual {
    position: relative;
    display: grid;
    justify-items: center;
  }
  .portrait {
    width: min(340px, 100%);
    aspect-ratio: 4/5;
    border-radius: 26px;
    position: relative;
    background: radial-gradient(220px 220px at 70% 20%, var(--violet-glow), transparent 70%),
      linear-gradient(160deg, var(--card-2), var(--bg-soft));
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .portrait .dots {
    position: absolute;
    inset: 0;
    opacity: 0.5;
    background-image: radial-gradient(color-mix(in srgb, var(--violet-soft) 30%, transparent) 1px, transparent 1px);
    background-size: 18px 18px;
    mask-image: radial-gradient(70% 70% at 60% 40%, #000, transparent);
  }
  .portrait-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .portrait-hint {
    position: relative;
    text-align: center;
    color: var(--muted);
    font-size: 13px;
    padding: 0 32px;
  }
  .portrait-hint .big {
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 800;
    color: color-mix(in srgb, var(--text) 16%, transparent);
    display: block;
    margin-bottom: 8px;
  }
  .exp-card {
    position: absolute;
    left: -8px;
    bottom: 26px;
    display: flex;
    align-items: center;
    gap: 14px;
    background: color-mix(in srgb, var(--card) 90%, transparent);
    backdrop-filter: blur(8px);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 14px 20px;
    box-shadow: var(--shadow-card);
  }
  .exp-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--violet) 15%, transparent);
    color: var(--violet-soft);
    font-size: 20px;
  }
  .exp-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
  }
  .exp-sub {
    font-size: 12.5px;
    color: var(--muted);
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .hero-visual {
      order: -1;
    }
    .exp-card {
      left: 8px;
    }
  }
</style>
