---
import fs from "node:fs";
import path from "node:path";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;

const imageExists = project.image
  ? fs.existsSync(path.join(process.cwd(), "public", project.image))
  : false;
---

<article class="project">
  <div class="shot">
    <span class="tag">{project.tag}</span>
    <span class={`status status-${project.status}`}>
      <i></i>
      {project.status === "production" ? "En producción" : "En desarrollo"}
    </span>
    <div class="browser">
      <div class="browser-bar"><i></i><i></i><i></i></div>
      {
        imageExists ? (
          <button type="button" class="shot-trigger" data-lightbox-src={project.image} data-lightbox-alt={`Captura del sistema ${project.name}`}>
            <img class="real-shot" src={project.image} alt={`Captura del sistema ${project.name}`} loading="lazy" />
          </button>
        ) : (
          <div class="placeholder-shot">
            <span>Captura próxima</span>
          </div>
        )
      }
    </div>
  </div>
  <div class="project-body">
    <h3>{project.name}</h3>
    <p>{project.description}</p>
  </div>
  <div class="stack">
    {project.stack.map((s) => <span>{s}</span>)}
  </div>
  <div class="project-foot">
    {
      project.treatment === "links" ? (
        <>
          {project.demoUrl ? (
            <a class="see" href={project.demoUrl} target="_blank" rel="noopener">
              Ver proyecto →
            </a>
          ) : (
            <span class="pending">Demo aún no desplegada</span>
          )}
          {project.repoUrl && (
            <a class="code" href={project.repoUrl} target="_blank" rel="noopener">
              Código
            </a>
          )}
        </>
      ) : (
        <span class="pending">{project.privateNote ?? "Repositorio privado"}</span>
      )
    }
  </div>
</article>

<style>
  .project {
    background: var(--card);
    border: 1px solid var(--line-soft);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.18s, border-color 0.18s;
  }
  .project:hover {
    transform: translateY(-4px);
    border-color: var(--line);
  }
  .shot {
    position: relative;
    padding: 14px 14px 0;
  }
  .tag {
    position: absolute;
    top: 24px;
    left: 24px;
    z-index: 2;
    font-size: 11.5px;
    font-weight: 600;
    color: #fff;
    background: linear-gradient(135deg, #6d4df6, #8b6bff);
    padding: 5px 12px;
    border-radius: 999px;
  }
  .status {
    position: absolute;
    top: 24px;
    right: 24px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    padding: 5px 11px;
    border-radius: 999px;
    backdrop-filter: blur(6px);
  }
  .status i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: inline-block;
  }
  .status-production {
    color: #4ade80;
    background: rgba(34, 197, 94, 0.14);
    border: 1px solid rgba(34, 197, 94, 0.3);
  }
  .status-production i {
    background: #4ade80;
  }
  .status-development {
    color: #fbbf24;
    background: rgba(245, 158, 11, 0.14);
    border: 1px solid rgba(245, 158, 11, 0.3);
  }
  .status-development i {
    background: #fbbf24;
  }
  .shot-trigger {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
  }
  .browser {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--line-soft);
    background: var(--bg);
  }
  .browser-bar {
    display: flex;
    gap: 5px;
    padding: 8px 10px;
    background: var(--card-2);
    border-bottom: 1px solid var(--line-soft);
  }
  .browser-bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--line);
  }
  .real-shot {
    width: 100%;
    height: 150px;
    object-fit: cover;
  }
  .placeholder-shot {
    height: 150px;
    display: grid;
    place-items: center;
    color: var(--muted);
    font-size: 13px;
    background: repeating-linear-gradient(
      135deg,
      var(--card-2),
      var(--card-2) 10px,
      var(--bg) 10px,
      var(--bg) 20px
    );
  }
  .project-body {
    padding: 20px 22px 0;
    flex: 1;
  }
  .project-body h3 {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 10px;
  }
  .project-body p {
    font-size: 14px;
    color: var(--muted);
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 16px 22px 6px;
  }
  .stack span {
    font-size: 11.5px;
    color: var(--muted);
    background: var(--card-2);
    border: 1px solid var(--line-soft);
    padding: 4px 10px;
    border-radius: 7px;
  }
  .project-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 22px 20px;
    margin-top: 6px;
    gap: 10px;
  }
  .project-foot a,
  .project-foot .pending {
    font-size: 13.5px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    transition: color 0.15s;
  }
  .project-foot .see {
    color: var(--violet-soft);
    font-weight: 600;
  }
  .project-foot .code {
    color: var(--muted);
  }
  .project-foot .code:hover {
    color: var(--text);
  }
  .project-foot .pending {
    color: var(--muted);
    font-style: italic;
  }
</style>
